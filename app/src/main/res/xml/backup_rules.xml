<?xml version="1.0" encoding="utf-8"?>
<!-- Personal prayer records stay on this device. This includes Room WAL/SHM
     files, DataStore intentions/history, reading state and future local stores. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
