      "text": {
        "es": "San José, guardián de la sagrada familia, bendice nuestras familias.",
        "en": "St Joseph, guardian of the holy family, bless our families.",
        "pt": "São José, guardião da sagrada família, abençoa as nossas famílias."
      }
    },
