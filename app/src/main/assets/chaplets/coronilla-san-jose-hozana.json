  "title": {
    "es": "Coronilla a San José",
    "en": "Chaplet of Saint Joseph",
    "pt": "Coronilha de São José"
  },
  "summary": {
    "es": "Cuentas violetas en tríadas y cuentas grandes blancas para pedir protección a la familia y una buena muerte.",
    "en": "Violet beads in triads and white large beads, asking St Joseph for family protection and a good death.",
    "pt": "Contas violeta em tríades e contas grandes brancas, pedindo a São José proteção da família e uma boa morte."
  },
  "instrument": {
    "es": "60 cuentas pequeñas violetas agrupadas en tríadas, separadas por cuentas grandes blancas; medalla y cruz.",
    "en": "60 small violet beads in triads, separated by white large beads; medal and cross.",
    "pt": "60 contas pequenas violeta em tríades, separadas por contas grandes brancas; medalha e cruz."
  },
  "when": {
    "es": "Para ayuda y protección del hogar y la gracia de una buena muerte.",
    "en": "For help and protection of the home and the grace of a good death.",
    "pt": "Para auxílio e proteção do lar e a graça de uma boa morte."
  },
